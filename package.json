{
  "name": "udemy-playwright",
  "version": "1.0.0",
  "description": "Automated software testing with Playwright",
  "main": "index.js",
  "scripts": {
    "tests:chrome": "npx playwright test --config=e2e.config.ts --project=Chromium --reporter=list",
    "tests:firefox": "npx playwright test --config=e2e.config.ts --project=Firefox --reporter=list",
    "tests:webkit": "npx playwright test --config=e2e.config.ts --project=WebKit --reporter=list",
    "tests:api": "npx playwright test --config=api.config.ts --project=Chromium --reporter=list",
    "jenkins-server": "java -jar jenkins.war --httpPort=8080 --enable-future-java"
  },
  "author": "tparashchenko",
  "license": "ISC",
  "dependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
